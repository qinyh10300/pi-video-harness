{
  "name": "@pi-video-harness/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean",
    "clean": "rm -rf dist",
    "test": "vitest run --root ../.. packages/core/src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pi-video-harness/contracts": "workspace:*"
  }
}
